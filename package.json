{
  "name": "dsh-region",
  "version": "0.3.0",
  "description": "还在为下插件经常卡住或失败而烦恼么？下载本插件即可。全自动在国内镜像和官方源间换路续下，还带面板能手动查看与切换。没啦！",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test-region.mjs && node test-failover.mjs && node test-http.mjs && node test-npmrc.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "registry",
    "npmmirror",
    "plugin"
  ],
  "license": "MIT",
  "author": "nononononofish",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nononononofish/dsh-region.git"
  },
  "homepage": "https://github.com/nononononofish/dsh-region#readme",
  "bugs": {
    "url": "https://github.com/nononononofish/dsh-region/issues"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "typescript": "^7.0.2"
  }
}

{
  "name": "dsh-region",
  "version": "0.1.0",
  "description": "DSH 下载源主备切换插件：国内镜像为主、官方源为备，超时/失败自动切换，Web UI 可查看与手动切换",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test-region.mjs && node test-failover.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "registry",
    "npmmirror",
    "plugin"
  ],
  "license": "MIT",
  "author": "nononononofish",
  "repository": {
    "type": "git",
    "url": "https://github.com/nononononofish/dsh-region.git"
  },
  "homepage": "https://github.com/nononononofish/dsh-region#readme",
  "bugs": {
    "url": "https://github.com/nononononofish/dsh-region/issues"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
